# ==============================================================================
# Application Environment Configuration Example
# Duplicate this file to `.env` and fill in your actual credentials/URLs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Configuration
# ------------------------------------------------------------------------------
# Set this to your backend API base URL (e.g., https://localhost:7131 during dev,
# or your deployed backend production URL).
# If left empty, API calls will default to fallback URLs or local Express server.
VITE_API_BASE_URL="https://exhume-amends-coasting.ngrok-free.dev"

# ------------------------------------------------------------------------------
# 2. AI & Third-Party Integration Services
# ------------------------------------------------------------------------------
# Required for Gemini AI / Sacred Archivist Chatbot integration.
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 3. App / Hosting Configuration
# ------------------------------------------------------------------------------
# The URL where this applet is hosted (used for OAuth callbacks, self-referential links, etc.).
APP_URL="http://localhost:5173"